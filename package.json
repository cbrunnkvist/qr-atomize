{
  "name": "qr-atomize",
  "version": "1.4.1",
  "description": "Atomize any QR code image \u2014 1 pixel per module.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "qr-atomize": "dist/bin/qr-atomize.js"
  },
  "files": [
    "dist/src",
    "dist/bin"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/index.test.js test/index.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "qr",
    "qr-code",
    "atomize",
    "minimize",
    "pixel",
    "module"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cwasm/webp": "^0.1.5",
    "cross-image": "^0.4.3",
    "fast-png": "^8.0.0",
    "jsqr": "^1.4.0",
    "qr": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbrunnkvist/qr-atomize.git"
  },
  "homepage": "https://github.com/cbrunnkvist/qr-atomize#readme",
  "bugs": {
    "url": "https://github.com/cbrunnkvist/qr-atomize/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
