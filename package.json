{
  "name": "qr-atomize",
  "version": "1.3.0",
  "description": "Atomize any QR code image — 1 pixel per module.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "qr-atomize": "dist/bin/qr-atomize.js"
  },
  "files": [
    "dist/src",
    "dist/bin"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node dist/test/index.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "qr",
    "qr-code",
    "atomize",
    "minimize",
    "pixel",
    "module"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cross-image": "^0.4.3",
    "qr": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
